#!/usr/bin/env bash
# Entry point for the harness. Resolves the repo root from its own location so
# it works from any cwd and, more importantly, so `sparkbench measure` always
# reaches the same canonical database rather than whichever `results/` happens
# to be under the shell's working directory. The previous attempt opened
# `results/runs.sqlite` by a relative path from six entry points and ended up
# with two databases, neither of which was a superset of the other.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
export SPARKBENCH_DB="${SPARKBENCH_DB:-$here/results/runs.sqlite}"
# -P is not optional. Without it `python3 -m` prepends the CURRENT DIRECTORY to
# sys.path, ahead of PYTHONPATH. A stray copy of the package at the repo root --
# one careless `rsync src/ host:repo/` puts one there -- then shadows src/ and
# the harness silently runs code that is not the code in git. That happened on
# 2026-09-04; the two copies differed only in comments, so nothing looked wrong,
# and the only symptom was a KV dtype string reading "bfloat16," instead of
# "bfloat16". Next time the difference would not be cosmetic.
exec python3 -P -m sparkbench.cli "$@"
